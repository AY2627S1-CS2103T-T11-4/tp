<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<HBox id="cardPane" fx:id="cardPane" alignment="CENTER_LEFT" spacing="11" styleClass="student-card"
      xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="9" right="10" bottom="9" left="10" />
  </padding>
  <Label fx:id="avatar" alignment="CENTER" minWidth="42" prefWidth="42" maxWidth="42"
         minHeight="42" prefHeight="42" maxHeight="42" styleClass="student-avatar" />
  <VBox alignment="CENTER_LEFT" spacing="3" HBox.hgrow="ALWAYS">
    <HBox alignment="CENTER_LEFT" spacing="6">
      <Label fx:id="name" styleClass="student-name" HBox.hgrow="ALWAYS" />
      <Label fx:id="id" styleClass="student-index" />
    </HBox>
    <Label fx:id="phone" styleClass="student-detail" />
    <Label fx:id="email" styleClass="student-detail" textOverrun="ELLIPSIS" />
    <Label fx:id="address" styleClass="student-detail" textOverrun="ELLIPSIS" wrapText="true" />
    <FlowPane fx:id="tags" hgap="5" vgap="3" styleClass="student-tags" />
  </VBox>
</HBox>
