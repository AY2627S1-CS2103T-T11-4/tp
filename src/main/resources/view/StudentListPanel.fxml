<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="8" styleClass="student-list-panel" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="13" right="8" bottom="10" left="8" />
  </padding>
  <Label text="Students" styleClass="section-heading" />
  <ListView fx:id="studentListView" styleClass="student-list-view" VBox.vgrow="ALWAYS" />
</VBox>
