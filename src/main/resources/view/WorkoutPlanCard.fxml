<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox minWidth="190" prefWidth="190" maxWidth="190" minHeight="136" prefHeight="136" maxHeight="170"
      spacing="7" styleClass="workout-plan-card" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="11" right="12" bottom="11" left="12" />
  </padding>
  <HBox alignment="CENTER_LEFT" spacing="8">
    <Label fx:id="id" alignment="CENTER" minWidth="38" prefWidth="38" maxWidth="38"
           minHeight="38" prefHeight="38" maxHeight="38" styleClass="plan-id-badge" />
    <Label fx:id="title" maxWidth="112" styleClass="workout-plan-title" textOverrun="ELLIPSIS" />
  </HBox>
  <FlowPane fx:id="tags" hgap="5" vgap="4" styleClass="workout-plan-tags" />
  <Label fx:id="date" styleClass="workout-plan-date" />
  <Label fx:id="description" maxHeight="38" styleClass="workout-plan-description"
         textOverrun="ELLIPSIS" wrapText="true" />
</VBox>
