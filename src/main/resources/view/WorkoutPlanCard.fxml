<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox minWidth="190" prefWidth="190" maxWidth="190" minHeight="190" prefHeight="190" maxHeight="190"
      spacing="7" styleClass="workout-plan-card" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="11" right="12" bottom="11" left="12" />
  </padding>
  <HBox alignment="CENTER_LEFT" spacing="8">
    <Label fx:id="id" alignment="CENTER" minWidth="38" prefWidth="38" maxWidth="38"
           minHeight="38" prefHeight="38" maxHeight="38" styleClass="plan-id-badge" />
    <Label fx:id="title" maxWidth="112" styleClass="workout-plan-title" textOverrun="ELLIPSIS" />
  </HBox>
  <FlowPane fx:id="tags" hgap="5" maxHeight="38" maxWidth="166" prefWrapLength="166" vgap="4"
            styleClass="workout-plan-tags" />
  <HBox alignment="CENTER_LEFT" spacing="6">
    <Label fx:id="status" styleClass="workout-status-badge" />
    <Region HBox.hgrow="ALWAYS" />
    <Label fx:id="date" styleClass="workout-plan-date" />
  </HBox>
  <Label fx:id="description" minHeight="38" prefHeight="38" maxHeight="38" maxWidth="166"
         prefWidth="166" styleClass="workout-plan-description" textOverrun="ELLIPSIS" wrapText="true" />
</VBox>
