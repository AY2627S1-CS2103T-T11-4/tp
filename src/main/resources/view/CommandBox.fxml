<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>

<HBox alignment="CENTER_LEFT" styleClass="command-box" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <Label text=">_" styleClass="command-prompt" />
  <TextField fx:id="commandTextField" onAction="#handleCommandEntered"
             promptText="Type a command…" HBox.hgrow="ALWAYS" />
</HBox>
