<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="12" styleClass="workout-plan-panel" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="16" right="16" bottom="16" left="16" />
  </padding>
  <HBox alignment="CENTER_LEFT" styleClass="selected-student-header">
    <VBox alignment="CENTER_LEFT" spacing="1" HBox.hgrow="ALWAYS">
      <Label fx:id="heading" styleClass="selected-student-name" wrapText="true" />
      <Label fx:id="subtitle" styleClass="selected-student-subtitle" wrapText="true" />
    </VBox>
  </HBox>
  <StackPane alignment="CENTER" VBox.vgrow="ALWAYS">
    <ScrollPane fx:id="workoutPlanScrollPane" fitToWidth="true" hbarPolicy="NEVER"
                pannable="true" styleClass="workout-plan-scroll" vbarPolicy="AS_NEEDED"
                StackPane.alignment="TOP_LEFT">
      <content>
        <VBox fx:id="workoutPlanList" spacing="4" styleClass="workout-plan-list" />
      </content>
    </ScrollPane>
    <Label fx:id="emptyMessage" alignment="CENTER" maxWidth="360" styleClass="empty-message"
           textAlignment="CENTER" wrapText="true" StackPane.alignment="CENTER" />
  </StackPane>
</VBox>
