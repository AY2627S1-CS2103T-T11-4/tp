<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.Scene?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.stage.Stage?>

<fx:root height="720.0" minHeight="540.0" minWidth="520.0" resizable="true" title="Help"
         type="javafx.stage.Stage" width="680.0" xmlns="http://javafx.com/javafx/17"
         xmlns:fx="http://javafx.com/fxml/1">
  <icons>
    <Image url="@/images/help_icon.png" />
  </icons>
  <scene>
    <Scene>
      <stylesheets>
        <URL value="@HelpWindow.css" />
      </stylesheets>

      <BorderPane styleClass="help-window">
        <top>
          <VBox styleClass="help-header">
            <padding>
              <Insets top="18.0" right="22.0" bottom="16.0" left="22.0" />
            </padding>
            <Label text="BrotherGym Help" styleClass="help-title" />
            <HBox alignment="CENTER_LEFT" spacing="10.0">
              <TextField fx:id="commandSearchField" promptText="Search commands" styleClass="command-search-field"
                         HBox.hgrow="ALWAYS" />
              <Button fx:id="closeHelpButton" mnemonicParsing="false" onAction="#closeHelp" text="Close Help"
                      styleClass="close-help-button" />
            </HBox>
          </VBox>
        </top>

        <center>
          <ScrollPane fx:id="helpScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="help-scroll"
                      vbarPolicy="AS_NEEDED">
            <content>
              <VBox fx:id="commandSections" fillWidth="true" spacing="20.0" styleClass="command-sections">
                <padding>
                  <Insets top="18.0" right="22.0" bottom="24.0" left="22.0" />
                </padding>
              </VBox>
            </content>
          </ScrollPane>
        </center>

        <bottom>
          <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="help-footer">
            <padding>
              <Insets top="13.0" right="22.0" bottom="13.0" left="22.0" />
            </padding>
            <Button fx:id="userGuideButton" mnemonicParsing="false" onAction="#openUserGuide" text="Open User Guide"
                    styleClass="user-guide-button" />
          </HBox>
        </bottom>
      </BorderPane>
    </Scene>
  </scene>
</fx:root>
