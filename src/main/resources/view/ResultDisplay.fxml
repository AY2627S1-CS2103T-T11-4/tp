<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="2" styleClass="feedback-card" xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1">
  <padding>
    <Insets top="10" right="16" bottom="9" left="16" />
  </padding>
  <Label fx:id="lastCommand" text=">  Ready" styleClass="last-command" />
  <Label text="COMMAND FEEDBACK" styleClass="feedback-label" />
  <TextArea fx:id="resultDisplay" editable="false" focusTraversable="false"
            promptText="Your command results will appear here." styleClass="result-display" VBox.vgrow="ALWAYS" />
</VBox>
