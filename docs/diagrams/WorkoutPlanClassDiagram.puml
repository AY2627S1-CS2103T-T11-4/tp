@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor MODEL_COLOR
skinparam classBackgroundColor MODEL_COLOR

Class WorkoutPlan
Class WorkoutName
Class WorkoutDescription
Class WorkoutDate
enum WorkoutPlanStatus <<enumeration>>
Class WorkoutPlanTag
Class "{abstract}\n Tag" as Tag
Class ExercisesList
Class Exercise
Class ExerciseName
Class ExerciseDescription

WorkoutPlan --> "1" WorkoutName
WorkoutPlan --> "1" WorkoutDescription
WorkoutPlan --> "1" WorkoutDate
WorkoutPlan --> "1" WorkoutPlanStatus
WorkoutPlan --> "*" WorkoutPlanTag
WorkoutPlan --> "1" ExercisesList

WorkoutPlanTag --|> Tag
ExercisesList --> "*" Exercise
Exercise --> "1" ExerciseName
Exercise --> "1" ExerciseDescription
@enduml
