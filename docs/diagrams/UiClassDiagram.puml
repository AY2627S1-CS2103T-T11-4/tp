@startuml
!include style.puml
top to bottom direction
skinparam linetype ortho
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

package UI <<Rectangle>> {
Class "<<interface>>\nUi" as Ui
Class UiManager
Class "{abstract}\nUiPart\n(base class of all UI parts)" as UiPart
Class MainWindow
Class CommandBox
Class ResultDisplay
Class StudentListPanel
Class WorkoutPlanListPanel
Class StatusBarFooter
Class StudentCard
Class WorkoutPlanCard

package Help <<Rectangle>> {
Class HelpWindow
Class HelpCommandCard
Class HelpFieldControl
Class HelpSearch
Class HelpInput
}
}

package Logic <<Rectangle>> {
Class HiddenLogic #FFFFFF
}

package Model <<Rectangle>> {
Class HiddenModel #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Ui

UiManager .up.|> Ui
UiManager -down-> "1" MainWindow

MainWindow -left-|> UiPart

MainWindow *-down-> "1" CommandBox
MainWindow *-down-> "1" ResultDisplay
MainWindow *-down-> "1" StudentListPanel
MainWindow *-down-> "1" WorkoutPlanListPanel
MainWindow *-down-> "1" StatusBarFooter
MainWindow --> "0..1" HelpWindow
HelpWindow *-down-> "1" HelpSearch
HelpWindow *-down-> "1" HelpInput
HelpWindow *-down-> "*" HelpCommandCard
HelpCommandCard *-down-> "*" HelpFieldControl

StudentListPanel *-down-> "*" StudentCard
WorkoutPlanListPanel *-down-> "*" WorkoutPlanCard

StudentCard ..> Model
WorkoutPlanCard ..> Model
UiManager -right-> Logic
MainWindow -right-> Logic

CommandBox -[hidden]right- ResultDisplay
ResultDisplay -[hidden]right- StudentListPanel
StudentListPanel -[hidden]right- WorkoutPlanListPanel
WorkoutPlanListPanel -[hidden]right- StatusBarFooter
StatusBarFooter -[hidden]right- HelpWindow
HelpWindow -[hidden]right- HelpSearch
HelpSearch -[hidden]right- HelpInput
HelpCommandCard -[hidden]right- HelpFieldControl
StudentCard -[hidden]right- WorkoutPlanCard

@enduml
