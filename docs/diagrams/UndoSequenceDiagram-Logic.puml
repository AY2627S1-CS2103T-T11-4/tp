@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Logic LOGIC_COLOR_T1
participant ":LogicManager" as LogicManager LOGIC_COLOR
participant ":BrotherGymParser" as BrotherGymParser LOGIC_COLOR
participant "u:UndoCommand" as UndoCommand LOGIC_COLOR
end box

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
end box
participant ":Storage" as Storage
[-> LogicManager : execute(undo)
activate LogicManager

LogicManager -> BrotherGymParser : parseCommand(undo)
activate BrotherGymParser

create UndoCommand
BrotherGymParser -> UndoCommand
activate UndoCommand

UndoCommand --> BrotherGymParser
deactivate UndoCommand

BrotherGymParser --> LogicManager : u
deactivate BrotherGymParser

LogicManager -> UndoCommand : execute()
activate UndoCommand

UndoCommand -> Model : canUndoBrotherGym()
activate Model
Model --> UndoCommand : available
deactivate Model

alt undo unavailable
    UndoCommand --> LogicManager : boundary error
else undo available
    UndoCommand -> Model : undoBrotherGym()
    activate Model
    Model --> UndoCommand : restored data and view
    deactivate Model

    UndoCommand --> LogicManager : result
    LogicManager -> Storage : save active BrotherGym
    Storage --> LogicManager
end
deactivate UndoCommand
UndoCommand -[hidden]-> LogicManager : result
destroy UndoCommand

[<--LogicManager
deactivate LogicManager
@enduml
