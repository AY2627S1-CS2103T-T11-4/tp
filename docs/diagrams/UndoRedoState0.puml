@startuml
!include style.puml
skinparam ClassFontColor #000000
skinparam ClassBorderColor #000000
skinparam ClassBackgroundColor #FFFFAA

title Initial state: home

package States {
    class State1 as "<u>state0:BrotherGym</u>"
    class State2 as "<u>state1:BrotherGym</u>"
    class State3 as "<u>state2:BrotherGym</u>"
    class State4 as "<u>state3:BrotherGym</u>"
}

State1 -[hidden]right-> State2
State2 -[hidden]right-> State3
State3 -[hidden]right-> State4
hide State2
hide State3
hide State4

class Pointer as "Current State" #FFFFFF
Pointer -up-> State1
@end
