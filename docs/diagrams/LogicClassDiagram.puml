@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package Logic as LogicPackage {

Class "<<interface>>\nLogic" as Logic
Class LogicManager
Class "{abstract}\nCommand" as Command
Class XYZCommand
Class CommandResult
}

package Model {
Class "Model" as ModelApi <<interface>>
}

package Storage {
Class "Storage" as StorageApi <<interface>>
}

Class UI
UI ..> Logic : executes commands and observes state

LogicManager .right.|> Logic
XYZCommand -up-|> Command
LogicManager .left.> Command : executes

LogicManager --> ModelApi : reads/writes
LogicManager --> StorageApi : saves after success
StorageApi -[hidden]--> ModelApi
Command .[hidden]up.> StorageApi
Command .right.> ModelApi : reads/writes
note right of XYZCommand: XYZCommand = AddStudentCommand,\nDeleteStudentCommand, etc.

Logic ..> CommandResult
LogicManager .down.> CommandResult
Command .up.> CommandResult : <<create>>
@enduml
