@startuml
!include style.puml
top to bottom direction
skinparam linetype ortho
skinparam nodesep 65
skinparam ranksep 70
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

class HiddenOutside #FFFFFF

package "Logic" as LogicComponent {
    class LogicManager
    class "<<interface>>\nLogic" as LogicApi

    package "Parser Classes" as ParserClasses {}

    class CommandResult
    class "{abstract}\nCommand" as Command
    class "{abstract}\nSingleIndexCommand" as SingleIndexCommand
    class XYZCommand
    class DeleteStudentCommand
}

package "Storage" as StorageComponent {}

package "Model" as ModelComponent {}

HiddenOutside ..> LogicApi
LogicManager .right.|> LogicApi
LogicManager --> "1" ParserClasses
LogicManager --> "1" StorageComponent
LogicManager --> "1" ModelComponent
LogicManager ..> Command : executes
LogicManager ..> CommandResult : returns
ParserClasses ..> Command : creates
LogicApi ..> CommandResult : returns
Command ..> ModelComponent
Command ..> CommandResult : returns

SingleIndexCommand -up-|> Command
XYZCommand -up-|> Command
DeleteStudentCommand -up-|> SingleIndexCommand

note right of XYZCommand
    Represents direct command subclasses,
    such as AddStudentCommand and FindCommand.
end note

HiddenOutside -[hidden]down-> LogicApi
LogicManager -[hidden]right-> LogicApi
LogicManager -[hidden]down-> ParserClasses
ParserClasses -[hidden]down-> CommandResult
CommandResult -[hidden]down-> Command
Command -[hidden]down-> XYZCommand
XYZCommand -[hidden]right-> SingleIndexCommand
SingleIndexCommand -[hidden]down-> DeleteStudentCommand
LogicComponent -[hidden]right-> StorageComponent
StorageComponent -[hidden]down-> ModelComponent

@enduml
