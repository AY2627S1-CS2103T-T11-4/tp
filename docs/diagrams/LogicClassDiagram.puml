@startuml
!include style.puml
top to bottom direction
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 45
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

class UI

package Logic {
    interface Logic
    class LogicManager
    class BrotherGymParser
    abstract class Command
    class ViewStudentCommand
    class CommandResult
}

interface Model
interface Storage

UI ..> Logic
LogicManager .up.|> Logic
LogicManager --> BrotherGymParser
BrotherGymParser ..> Command
LogicManager --> Command
ViewStudentCommand --|> Command
Command --> Model
LogicManager --> Model
LogicManager --> Storage
Command ..> CommandResult
Logic ..> CommandResult
@enduml
