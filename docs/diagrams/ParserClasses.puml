@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

Class "{abstract}\nCommand" as Command
Class XYZCommand
Class "{abstract}\nSingleIndexCommand" as SingleIndexCommand

package "Parser classes"{
    Class "<<interface>>\nParser" as Parser
    Class BrotherGymParser
    Class XYZCommandParser
    Class SingleIndexCommandParser
    Class NoArgumentCommandParser

    package "Argument Processors" as ArgProcessor {}
    Class ParserUtil
    Class CliSyntax
    Class Prefix
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> BrotherGymParser

BrotherGymParser *--> " *  " Parser
XYZCommandParser .up.|> Parser
SingleIndexCommandParser .up.|> Parser
NoArgumentCommandParser .up.|> Parser

XYZCommandParser .up.> XYZCommand : creates
SingleIndexCommandParser .down.> SingleIndexCommand : creates
NoArgumentCommandParser .up.> XYZCommand : creates

BrotherGymParser ..> Command : returns
XYZCommand -up-|> Command
SingleIndexCommand -up-|> Command

XYZCommandParser ..> ArgProcessor
SingleIndexCommandParser ..> ArgProcessor
NoArgumentCommandParser ..> ArgProcessor
XYZCommandParser ..> ParserUtil
SingleIndexCommandParser ..> ParserUtil
XYZCommandParser ..> CliSyntax

note right of XYZCommandParser
    Represents dedicated
    parser classes such as
    AddStudentCommandParser
    and FindCommandParser.
end note

ArgProcessor ..> Prefix
CliSyntax ..> Prefix
ParserUtil ..> Prefix

ArgProcessor -[hidden]right- ParserUtil
ParserUtil -[hidden]right- CliSyntax

@enduml
