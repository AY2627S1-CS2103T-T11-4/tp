@startuml
!include style.puml
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

Class "{abstract}\nCommand" as Command
Class XYZCommand
Class SingleIndexCommand

package "Parser classes"{
    Class "<<interface>>\nParser" as Parser
    Class BrotherGymParser
    Class XYZCommandParser
    Class SingleIndexCommandParser

    package "Argument Processors" {}
    Class ParserUtil
    Class CliSyntax
    Class Prefix
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> BrotherGymParser

BrotherGymParser ..> Parser : <<create>>
XYZCommandParser .up.|> Parser
SingleIndexCommandParser .up.|> Parser

XYZCommandParser .up.> XYZCommand : <<create>>
SingleIndexCommandParser .up.> SingleIndexCommand : <<create>>

BrotherGymParser ..> Command : <<create>>
XYZCommand -up-|> Command
SingleIndexCommand -up-|> Command

XYZCommandParser ..> "Argument Processors"
SingleIndexCommandParser ..> "Argument Processors"
XYZCommandParser ..> ParserUtil
SingleIndexCommandParser ..> ParserUtil
XYZCommandParser ..> CliSyntax
SingleIndexCommandParser ..> CliSyntax

"Argument Processors" ..> Prefix
CliSyntax ..> Prefix
ParserUtil ..> Prefix

@enduml
