@startuml
!include style.puml
top to bottom direction
skinparam linetype polyline
skinparam nodesep 35
skinparam ranksep 45
skinparam arrowThickness 1.1
skinparam arrowColor LOGIC_COLOR_T4
skinparam classBackgroundColor LOGIC_COLOR

package "Command selection" as Selection {
    class BrotherGymParser
}

package "Parser implementations" as Parsers {
    interface Parser
    class SingleIndexCommandParser
    class AddStudentCommandParser
    class FindCommandParser
}

package "Parser helpers" as Helpers {
    class ArgumentTokenizer
    class ArgumentMultimap
    class ArgumentValidator
    class ParserUtil
    class CliSyntax
    class Prefix
}

package Commands {
    abstract class Command
}

Selection --> Parsers : selects parser
Parsers ..> Helpers : used where needed
Parsers ..> Commands : returns commands
SingleIndexCommandParser ..|> Parser
AddStudentCommandParser ..|> Parser
FindCommandParser ..|> Parser
ArgumentTokenizer --> ArgumentMultimap
ArgumentValidator --> ArgumentMultimap
CliSyntax --> Prefix
@enduml
