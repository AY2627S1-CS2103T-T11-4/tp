@startuml
!include style.puml
skinparam ArrowFontStyle plain

box Model MODEL_COLOR_T1
participant ":Model" as Model MODEL_COLOR
participant ":VersionedBrotherGym" as VersionedBrotherGym MODEL_COLOR
end box

[-> Model : undoBrotherGym()
activate Model

Model -> VersionedBrotherGym : undo()
activate VersionedBrotherGym

VersionedBrotherGym -> VersionedBrotherGym :resetData(ReadOnlyBrotherGym)
VersionedBrotherGym --> Model :
deactivate VersionedBrotherGym

[<-- Model
deactivate Model

@enduml
