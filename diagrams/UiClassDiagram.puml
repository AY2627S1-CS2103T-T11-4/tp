@startuml
!include style.puml
left to right direction
skinparam linetype ortho
skinparam arrowThickness 1.1
skinparam arrowColor UI_COLOR_T4
skinparam classBackgroundColor UI_COLOR

package UI <<Rectangle>> {
    Class "<<interface>>\nUi" as Ui
    Class UiManager
    Class "{abstract}\nUiPart\n(base class of all UI parts)" as UiPart
    Class MainWindow

    together {
        Class CommandBox
        Class ResultDisplay
        Class StatusBarFooter
        Class HelpWindow
    }

    together {
        Class StudentListPanel
        Class StudentCard
    }

    together {
        Class WorkoutPlanListPanel
        Class WorkoutPlanCard
    }
}

package Logic <<Rectangle>> {
Class HiddenLogic #FFFFFF
}

package Model <<Rectangle>> {
Class HiddenModel #FFFFFF
}

Class HiddenOutside #FFFFFF
HiddenOutside ..> Ui

UiManager .up.|> Ui
UiManager *-right-> "1" MainWindow : owns >

MainWindow -up-|> UiPart
HelpWindow -left-|> UiPart

MainWindow *-right-> "1" CommandBox
MainWindow *-right-> "1" ResultDisplay
MainWindow *-right-> "1" StatusBarFooter
MainWindow -right-> "0..1" HelpWindow
MainWindow *-down-> "1" StudentListPanel
MainWindow *-down-> "1" WorkoutPlanListPanel

StudentListPanel *-down-> "*" StudentCard
WorkoutPlanListPanel *-down-> "*" WorkoutPlanCard

StudentCard ..> Model
WorkoutPlanCard ..> Model
UiManager -up-> Logic
MainWindow -up-> Logic
HelpWindow .down.> Logic

CommandBox -[hidden]down- ResultDisplay
ResultDisplay -[hidden]down- StatusBarFooter
StatusBarFooter -[hidden]down- HelpWindow
StudentListPanel -[hidden]right- WorkoutPlanListPanel
StudentCard -[hidden]right- WorkoutPlanCard

@enduml
